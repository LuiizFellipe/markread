{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkRead",
  "version": "0.3.0",
  "identifier": "com.markread.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkRead",
        "width": 1100,
        "height": 760,
        "minWidth": 620,
        "minHeight": 420,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright © 2026 MarkRead contributors",
    "shortDescription": "Clean Markdown reader.",
    "longDescription": "MarkRead is a clean, fast Markdown reader with GitHub-style rendering, outline navigation, find-in-page, light/dark themes and first-class Markdown file associations on Linux, macOS and Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./desktop-entry.desktop"
      },
      "rpm": {
        "desktopTemplate": "./desktop-entry.desktop"
      }
    }
  }
}
